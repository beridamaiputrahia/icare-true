APP_NAME="I Care True"
APP_ENV=production
APP_KEY=base64:/7Zv8epFRWv/QKPw39azHqtxSdjfoipNplVeVdljWoU=
APP_DEBUG=false
APP_URL=https://DOMAIN_ANDA.infinityfreeapp.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# InfinityFree hanya menyediakan MySQL. Ambil kredensial ini dari
# Client Area > MySQL Databases setelah membuat database.
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXX_icaretrue
DB_USERNAME=if0_XXXXXXX
DB_PASSWORD=PASSWORD_DATABASE_HOSTING

# InfinityFree tidak mendukung proses persisten (file session/cache aman & tidak butuh tabel tambahan)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# PENTING: InfinityFree tidak bisa menjalankan Laravel Reverb (WebSocket server).
# Broadcast di-set ke "log" agar tidak error; fitur real-time (live chat, game)
# akan berfungsi sebagai fallback biasa (butuh refresh/polling), bukan real-time.
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# InfinityFree tidak punya queue worker/cron sungguhan yang bisa dipercaya.
# QUEUE_CONNECTION=sync membuat job (mis. kirim notifikasi) berjalan langsung
# saat request terjadi, bukan di background.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Gunakan SMTP eksternal (mis. Gmail App Password) karena InfinityFree
# memblokir fungsi mail() bawaan untuk domain gratis.
MAIL_MAILER=smtp
MAIL_HOST=SMTP_HOST_ANDA
MAIL_PORT=465
MAIL_USERNAME=EMAIL_ANDA
MAIL_PASSWORD=PASSWORD_EMAIL
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@DOMAIN_ANDA.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
