APP_NAME="I Care True"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://NAMA-APP-ANDA.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Railway menyediakan variabel ini otomatis kalau Anda menambahkan
# plugin/service MySQL dari dashboard Railway (klik "+ New" > Database > MySQL).
# Gunakan referensi variabel Railway, JANGAN hardcode nilai di sini:
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Reverb WebSocket berjalan sebagai service terpisah di Railway (lihat panduan).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=icaretrue
REVERB_APP_KEY=icaretrue-key
REVERB_APP_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
REVERB_HOST=NAMA-APP-REVERB-ANDA.up.railway.app
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=SMTP_HOST_ANDA
MAIL_PORT=465
MAIL_USERNAME=EMAIL_ANDA
MAIL_PASSWORD=PASSWORD_EMAIL
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@NAMA-APP-ANDA.up.railway.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
