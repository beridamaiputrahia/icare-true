APP_NAME="I Care True"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://icare-true.onrender.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Render free tier hanya sediakan PostgreSQL (bukan MySQL). Kalau deploy lewat
# render.yaml (Blueprint), variabel ini otomatis terisi dari database
# "icare-true-db" yang didefinisikan di render.yaml — tidak perlu diisi manual.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Render free tier tidak mendukung proses persisten tambahan (WebSocket
# server terpisah seperti Reverb tidak bisa berjalan di free plan). Live
# chat & game online tetap bisa real-time lewat Pusher Channels — layanan
# WebSocket cloud pihak ketiga dengan free tier gratis selamanya (200rb
# pesan/hari, 100 koneksi bersamaan), jadi tidak perlu server sendiri.
# Daftar gratis di pusher.com > Channels > Create app, lalu salin
# App Key, App Secret, App ID, dan Cluster dari halaman "App Keys".
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=GANTI_APP_ID
PUSHER_APP_KEY=GANTI_APP_KEY
PUSHER_APP_SECRET=GANTI_APP_SECRET
PUSHER_APP_CLUSTER=ap1

# PENTING: Render free tier TIDAK punya persistent disk — semua file yang
# di-upload lewat "local"/"public" disk akan HILANG setiap kali container
# di-redeploy/restart. Wajib pakai Cloudinary (gratis) supaya file upload
# (foto profil, foto member, gambar pengumuman, dll) tetap ada selamanya.
# Daftar gratis di cloudinary.com, lalu salin "API Environment variable"
# dari Dashboard (bentuknya: cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
FILESYSTEM_DISK=cloudinary
CLOUDINARY_URL=cloudinary://GANTI_API_KEY:GANTI_API_SECRET@GANTI_CLOUD_NAME

QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=SMTP_HOST_ANDA
MAIL_PORT=465
MAIL_USERNAME=EMAIL_ANDA
MAIL_PASSWORD=PASSWORD_EMAIL
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@icare-true.onrender.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
